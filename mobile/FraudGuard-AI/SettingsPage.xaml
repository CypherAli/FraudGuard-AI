<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FraudGuardAI.SettingsPage"
             xmlns:loc="clr-namespace:FraudGuardAI.Localization"
             Title="{loc:Translate Key=Settings_Title}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,48,20,32" Spacing="16">
            
            <!-- Header -->
            <VerticalStackLayout Spacing="4" Margin="0,0,0,8">
                  <Label FontSize="28"
                      FontAttributes="Bold"
                      TextColor="{DynamicResource TextPrimary}"
                      Text="{loc:Translate Key=Settings_Title}"/>
                
                  <Label FontSize="14"
                      TextColor="{DynamicResource TextSecondary}"
                      Text="{loc:Translate Key=Settings_Subtitle}"/>
            </VerticalStackLayout>

            <!-- Profile Section -->
            <Border BackgroundColor="{DynamicResource CardBg}"
                   StrokeThickness="0"
                   Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000" Opacity="0.25" Radius="16" Offset="0,6"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">
                    <!-- Avatar -->
                    <Grid HorizontalOptions="Center">
                           <Border WidthRequest="80"
                               HeightRequest="80"
                               BackgroundColor="{StaticResource TealIcon}"
                               StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="40"/>
                            </Border.StrokeShape>
                            <Grid>
                                <Image x:Name="AvatarImage"
                                    Aspect="AspectFill"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill"
                                    IsVisible="False"/>
                                <Label x:Name="AvatarInitials"
                                    Text="ND"
                                    FontSize="28"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                        <!-- Camera Icon -->
                        <Border WidthRequest="28"
                               HeightRequest="28"
                               BackgroundColor="{StaticResource TealIcon}"
                               StrokeThickness="2"
                               Stroke="{DynamicResource BackgroundColor}"
                               HorizontalOptions="End"
                               VerticalOptions="End"
                               Margin="0,0,-4,-4">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnChangeAvatarClicked"/>
                            </Border.GestureRecognizers>
                            <Label Text="📷" FontSize="12"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                    </Grid>
                    
                    <!-- Name & Email -->
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                           <Label x:Name="UserNameLabel"
                               Text="{loc:Translate Key=Settings_DefaultUserName}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}"
                               HorizontalOptions="Center"/>
                        <Label x:Name="UserEmailLabel"
                               Text="user@example.com"
                               FontSize="14"
                               TextColor="{DynamicResource TextSecondary}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    
                    <!-- Phone Number Row -->
                    <Grid ColumnDefinitions="*,Auto">
                           <Label FontSize="14"
                               TextColor="{DynamicResource TextSecondary}"
                               VerticalOptions="Center"
                               Text="{loc:Translate Key=Settings_PhoneLabel}"/>
                        <Label x:Name="PhoneNumberLabel"
                               Grid.Column="1"
                               Text="{loc:Translate Key=Settings_NotUpdated}"
                               FontSize="14"
                               TextColor="{DynamicResource TextPrimary}"
                               VerticalOptions="Center"/>
                    </Grid>
                    
                    <!-- Edit Profile Button -->
                    <Border BackgroundColor="{DynamicResource StatCardBg}"
                           StrokeThickness="0"
                           Padding="16,12"
                           HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEditProfileClicked"/>
                        </Border.GestureRecognizers>
                        
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="✏️" FontSize="14" VerticalOptions="Center"/>
                            <Label FontSize="14"
                                TextColor="{DynamicResource TextPrimary}"
                                VerticalOptions="Center"
                                Text="{loc:Translate Key=Settings_EditProfile}"/>
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- GIAO DIỆN Section -->
            <VerticalStackLayout Spacing="8">
                  <Label FontSize="12"
                      FontAttributes="Bold"
                      TextColor="{DynamicResource TextSecondary}"
                      Margin="4,8,0,0"
                      Text="{loc:Translate Key=Settings_UISection}"/>
                
                <Border BackgroundColor="{DynamicResource CardBg}"
                       StrokeThickness="0"
                       Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    
                    <VerticalStackLayout Spacing="0">
                        <!-- Auto Protection Toggle -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,8">
                            <Border WidthRequest="36" HeightRequest="36"
                                   BackgroundColor="#14B8A620"
                                   StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Label Text="🛡" FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            
                            <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                                    <Label FontSize="15"
                                        TextColor="{DynamicResource TextPrimary}"
                                        Text="{loc:Translate Key=Settings_AutoProtection}"/>
                                    <Label FontSize="12"
                                        TextColor="{DynamicResource TextSecondary}"
                                        Text="{loc:Translate Key=Settings_AutoProtectionDesc}"/>
                            </VerticalStackLayout>
                            
                            <Switch x:Name="AutoProtectionSwitch"
                                   Grid.Column="2"
                                   IsToggled="True"
                                   OnColor="{StaticResource TealIcon}"
                                   ThumbColor="White"/>
                        </Grid>
                        
                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource BorderColor}" Margin="48,8,0,8"/>
                        
                        <!-- Dark Mode Toggle -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,8">
                            <Border WidthRequest="36" HeightRequest="36"
                                   BackgroundColor="{StaticResource AccentBlue20}"
                                   StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                    <Label Text="☀️" FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            
                            <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                                                <Label FontSize="15"
                                                    TextColor="{DynamicResource TextPrimary}"
                                                    Text="{loc:Translate Key=Settings_LightMode}"/>
                                                <Label FontSize="12"
                                                    TextColor="{DynamicResource TextSecondary}"
                                                    Text="{loc:Translate Key=Settings_LightModeDesc}"/>
                            </VerticalStackLayout>
                            
                            <Switch x:Name="DarkModeSwitch"
                                   Grid.Column="2"
                                IsToggled="False"
                                   OnColor="{StaticResource TealIcon}"
                                   ThumbColor="White"
                                   Toggled="OnDarkModeToggled"/>
                        </Grid>
                        
                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource BorderColor}" Margin="48,8,0,8"/>
                        
                        <!-- Language Selector -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,8">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLanguageClicked"/>
                            </Grid.GestureRecognizers>
                            
                            <Border WidthRequest="36" HeightRequest="36"
                                   BackgroundColor="#FBBF2420"
                                   StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Label Text="🌐" FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            
                            <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                                    <Label FontSize="15"
                                        TextColor="{DynamicResource TextPrimary}"
                                        Text="{loc:Translate Key=Settings_Language}"/>
                                <Label x:Name="LanguageLabel"
                                        Text="{loc:Translate Key=Language_Current}"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextSecondary}"/>
                            </VerticalStackLayout>
                            
                            <Label Grid.Column="2" Text="›"
                                   FontSize="20"
                                   TextColor="{DynamicResource TextSecondary}"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- BẢO MẬT Section -->
            <VerticalStackLayout Spacing="8">
                  <Label FontSize="12"
                      FontAttributes="Bold"
                      TextColor="{DynamicResource TextSecondary}"
                      Margin="4,8,0,0"
                      Text="{loc:Translate Key=Settings_SecuritySection}"/>
                
                <Border BackgroundColor="{DynamicResource CardBg}"
                       StrokeThickness="0"
                       Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSecurityClicked"/>
                    </Border.GestureRecognizers>
                    
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,8">
                        <Border WidthRequest="36" HeightRequest="36"
                               BackgroundColor="#EF444420"
                               StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Label Text="🔐" FontSize="16"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        
                        <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                            <Label FontSize="15"
                                TextColor="#F87171"
                                Text="{loc:Translate Key=Settings_AccountSecurity}"/>
                            <Label FontSize="12"
                                TextColor="{DynamicResource TextSecondary}"
                                Text="{loc:Translate Key=Settings_AccountSecurityDesc}"/>
                        </VerticalStackLayout>
                        
                        <Label Grid.Column="2" Text="›"
                               FontSize="20"
                               TextColor="{DynamicResource TextSecondary}"
                               VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Whitelist Management -->
                <Border BackgroundColor="{DynamicResource CardBg}"
                       StrokeThickness="0" Padding="16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnWhitelistClicked"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,8">
                        <Border WidthRequest="36" HeightRequest="36"
                               BackgroundColor="#14B8A620" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Label Text="📇" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                            <Label FontSize="15" TextColor="#14B8A6"
                                   Text="{loc:Translate Key=Settings_Whitelist}"/>
                            <Label FontSize="12" TextColor="{DynamicResource TextSecondary}"
                                   Text="{loc:Translate Key=Settings_WhitelistDesc}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="20"
                               TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Auto-Reject Blacklisted Calls -->
                <Border BackgroundColor="{DynamicResource CardBg}"
                       StrokeThickness="0" Padding="16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,8">
                        <Border WidthRequest="36" HeightRequest="36"
                               BackgroundColor="#EF444420" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Label Text="🚫" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                            <Label FontSize="15" TextColor="{DynamicResource TextPrimary}"
                                   Text="{loc:Translate Key=Settings_AutoReject}"/>
                            <Label FontSize="12" TextColor="{DynamicResource TextSecondary}"
                                   Text="{loc:Translate Key=Settings_AutoRejectDesc}"/>
                        </VerticalStackLayout>
                        <Switch x:Name="AutoRejectSwitch" Grid.Column="2"
                                OnColor="#EF4444" Toggled="OnAutoRejectToggled"
                                VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- SMS Fraud Detection -->
                <Border BackgroundColor="{DynamicResource CardBg}"
                       StrokeThickness="0" Padding="16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,8">
                        <Border WidthRequest="36" HeightRequest="36"
                               BackgroundColor="#FBBF2420" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Label Text="💬" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                            <Label FontSize="15" TextColor="{DynamicResource TextPrimary}"
                                   Text="{loc:Translate Key=Settings_SmsDetection}"/>
                            <Label FontSize="12" TextColor="{DynamicResource TextSecondary}"
                                   Text="{loc:Translate Key=Settings_SmsDetectionDesc}"/>
                        </VerticalStackLayout>
                        <Switch x:Name="SmsDetectionSwitch" Grid.Column="2"
                                OnColor="#FBBF24" Toggled="OnSmsDetectionToggled"
                                VerticalOptions="Center"/>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- KẾT NỐI Section -->
            <VerticalStackLayout Spacing="8">
                  <Label FontSize="12"
                      FontAttributes="Bold"
                      TextColor="{DynamicResource TextSecondary}"
                      Margin="4,8,0,0"
                      Text="{loc:Translate Key=Settings_ConnectionSection}"/>
                
                <Border BackgroundColor="{DynamicResource CardBg}"
                       StrokeThickness="0"
                       Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    
                    <VerticalStackLayout Spacing="12">
                        <!-- Server Status -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,8">
                            <Border WidthRequest="36" HeightRequest="36"
                                   BackgroundColor="{StaticResource AccentBlue20}"
                                   StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Label Text="🔗" FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            
                            <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                                    <Label FontSize="15"
                                        TextColor="{DynamicResource TextPrimary}"
                                        Text="{loc:Translate Key=Settings_ServerConnection}"/>
                                <HorizontalStackLayout Spacing="6">
                                    <Border x:Name="ServerStatusDot"
                                           WidthRequest="8" HeightRequest="8"
                                           BackgroundColor="{StaticResource SafeGreen}"
                                           StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="4"/>
                                        </Border.StrokeShape>
                                    </Border>
                                    <Label x:Name="ServerStatusLabel"
                                           Text=""
                                           FontSize="12"
                                           TextColor="{StaticResource SafeGreen}"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                        
                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource BorderColor}" Margin="0,4"/>
                        
                        <!-- USB Mode Toggle -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,8">
                            <Border WidthRequest="36" HeightRequest="36"
                                   BackgroundColor="#A855F720"
                                   StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Label Text="🔌" FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            
                            <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                                    <Label FontSize="15"
                                        TextColor="{DynamicResource TextPrimary}"
                                        Text="{loc:Translate Key=Settings_USBMode}"/>
                                    <Label FontSize="12"
                                        TextColor="{DynamicResource TextSecondary}"
                                        Text="{loc:Translate Key=Settings_USBModeDesc}"/>
                            </VerticalStackLayout>
                            
                            <Switch x:Name="UsbModeSwitch"
                                   Grid.Column="2"
                                   OnColor="{StaticResource TealIcon}"
                                   ThumbColor="White"
                                   Toggled="OnUsbModeToggled"/>
                        </Grid>
                        
                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource BorderColor}" Margin="0,4"/>
                        
                        <!-- Server Address -->
                        <VerticalStackLayout Spacing="8">
                            <HorizontalStackLayout Spacing="12">
                                <Border WidthRequest="36" HeightRequest="36"
                                       BackgroundColor="#14B8A620"
                                       StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Label Text="🌐" FontSize="16"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>
                                    <Label FontSize="15"
                                        TextColor="{DynamicResource TextPrimary}"
                                        VerticalOptions="Center"
                                        Text="{loc:Translate Key=Settings_ServerAddress}"/>
                            </HorizontalStackLayout>
                            
                            <!-- Server URL Input -->
                            <Border BackgroundColor="{DynamicResource InputBg}"
                                   StrokeThickness="1"
                                   Stroke="{DynamicResource BorderColor}"
                                   Padding="4">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                
                                <Entry x:Name="ServerIPEntry"
                                       Placeholder="https://xxxx.ngrok-free.app"
                                       PlaceholderColor="#5C6B7A"
                                       TextColor="{DynamicResource TextPrimary}"
                                       BackgroundColor="Transparent"
                                       FontSize="14"
                                       Keyboard="Url"
                                       Margin="12,8"/>
                            </Border>
                            
                            <!-- Hints -->
                            <Border BackgroundColor="{DynamicResource InputBg}"
                                   StrokeThickness="0"
                                   Padding="12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                
                                <VerticalStackLayout Spacing="4">
                                    <Label FontSize="12" TextColor="{DynamicResource TextSecondary}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{loc:Translate Key=Settings_NgrokLabel}"/>
                                                <Span Text="https://xxxx.ngrok-free.app" TextColor="{StaticResource SafeGreen}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label FontSize="12" TextColor="{DynamicResource TextSecondary}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{loc:Translate Key=Settings_LanLabel}"/>
                                                <Span Text="http://192.168.1.12:8080" TextColor="{StaticResource AccentBlue}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                            </Border>
                            
                            <!-- Current Config -->
                            <VerticalStackLayout Spacing="4">
                                    <Label FontSize="12"
                                        TextColor="{DynamicResource TextSecondary}"
                                        Text="{loc:Translate Key=Settings_CurrentConfig}"/>
                                <Label x:Name="CurrentConfigLabel"
                                       Text=""
                                       FontSize="12"
                                       TextColor="{StaticResource AccentBlue}"/>
                            </VerticalStackLayout>
                            
                            <!-- Action Buttons -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                                <Button x:Name="SaveButton"
                                       Grid.Column="0"
                                        Text="{loc:Translate Key=Settings_Save}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       BackgroundColor="{StaticResource TealIcon}"
                                       TextColor="#0D1B2A"
                                       CornerRadius="12"
                                       HeightRequest="44"
                                       Clicked="OnSaveButtonClicked"/>
                                
                                <Button x:Name="TestButton"
                                       Grid.Column="1"
                                        Text="{loc:Translate Key=Settings_Test}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       BackgroundColor="{DynamicResource StatCardBg}"
                                       TextColor="{DynamicResource TextPrimary}"
                                       CornerRadius="12"
                                       HeightRequest="44"
                                       Clicked="OnTestConnectionClicked"/>
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- TRỢ GIÚP Section -->
            <Border BackgroundColor="{DynamicResource CardBg}"
                   StrokeThickness="0"
                   Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHelpClicked"/>
                </Border.GestureRecognizers>
                
                <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,8">
                    <Border WidthRequest="36" HeightRequest="36"
                           BackgroundColor="{StaticResource AccentBlue20}"
                           StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Label Text="❓" FontSize="16"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                    
                    <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                           <Label FontSize="15"
                               TextColor="{DynamicResource TextPrimary}"
                               Text="{loc:Translate Key=Settings_HelpTitle}"/>
                           <Label FontSize="12"
                               TextColor="{DynamicResource TextSecondary}"
                               Text="{loc:Translate Key=Settings_HelpDesc}"/>
                    </VerticalStackLayout>
                    
                    <Label Grid.Column="2" Text="›"
                           FontSize="20"
                           TextColor="{DynamicResource TextSecondary}"
                           VerticalOptions="Center"/>
                </Grid>
            </Border>

            <!-- Logout Button -->
            <Border BackgroundColor="Transparent"
                   StrokeThickness="1"
                   Stroke="{StaticResource DangerRed}"
                   Padding="16"
                   Margin="0,16,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLogoutClicked"/>
                </Border.GestureRecognizers>
                
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                    <Label Text="🚪" FontSize="16" VerticalOptions="Center"/>
                          <Label FontSize="15"
                              FontAttributes="Bold"
                              TextColor="{StaticResource DangerRed}"
                              VerticalOptions="Center"
                              Text="{loc:Translate Key=Settings_Logout}"/>
                </HorizontalStackLayout>
            </Border>

            <!-- Version Info -->
                 <Label FontSize="12"
                     TextColor="{DynamicResource TextSecondary}"
                     HorizontalOptions="Center"
                     Margin="0,16,0,0"
                     Text="{loc:Translate Key=Settings_Version}"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

