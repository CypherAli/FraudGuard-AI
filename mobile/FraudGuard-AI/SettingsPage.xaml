<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FraudGuardAI.SettingsPage"
             Title="Settings"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,48,20,32" Spacing="16">
            
            <!-- Header -->
            <VerticalStackLayout Spacing="4" Margin="0,0,0,8">
                <Label Text="Cài đặt"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"/>
                
                <Label Text="Quản lý tài khoản và tùy chọn"
                       FontSize="14"
                       TextColor="{StaticResource TextSecondary}"/>
            </VerticalStackLayout>

            <!-- Profile Section -->
            <Border BackgroundColor="{StaticResource CardBg}"
                   StrokeThickness="0"
                   Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000" Opacity="0.25" Radius="16" Offset="0,6"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">
                    <!-- Avatar -->
                    <Grid HorizontalOptions="Center">
                        <Border WidthRequest="80"
                               HeightRequest="80"
                               BackgroundColor="{StaticResource TealIcon}"
                               StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="40"/>
                            </Border.StrokeShape>
                            <Label x:Name="AvatarInitials"
                                   Text="ND"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <!-- Camera Icon -->
                        <Border WidthRequest="28"
                               HeightRequest="28"
                               BackgroundColor="{StaticResource TealIcon}"
                               StrokeThickness="2"
                               Stroke="{StaticResource BackgroundDark}"
                               HorizontalOptions="End"
                               VerticalOptions="End"
                               Margin="0,0,-4,-4">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Label Text="📷" FontSize="12"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                    </Grid>
                    
                    <!-- Name & Email -->
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label x:Name="UserNameLabel"
                               Text="Người dùng"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               HorizontalOptions="Center"/>
                        <Label x:Name="UserEmailLabel"
                               Text="user@example.com"
                               FontSize="14"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    
                    <!-- Phone Number Row -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Số điện thoại"
                               FontSize="14"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center"/>
                        <Label x:Name="PhoneNumberLabel"
                               Grid.Column="1"
                               Text="Chưa cập nhật"
                               FontSize="14"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center"/>
                    </Grid>
                    
                    <!-- Edit Profile Button -->
                    <Border BackgroundColor="{StaticResource StatCardBg}"
                           StrokeThickness="0"
                           Padding="16,12"
                           HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEditProfileClicked"/>
                        </Border.GestureRecognizers>
                        
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="✏️" FontSize="14" VerticalOptions="Center"/>
                            <Label Text="Chỉnh sửa hồ sơ"
                                   FontSize="14"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- GIAO DIỆN Section -->
            <VerticalStackLayout Spacing="8">
                <Label Text="GIAO DIỆN"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextSecondary}"
                       Margin="4,8,0,0"/>
                
                <Border BackgroundColor="{StaticResource CardBg}"
                       StrokeThickness="0"
                       Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    
                    <VerticalStackLayout Spacing="0">
                        <!-- Auto Protection Toggle -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,8">
                            <Border WidthRequest="36" HeightRequest="36"
                                   BackgroundColor="#14B8A620"
                                   StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Label Text="🛡" FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            
                            <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                                <Label Text="Bảo vệ tự động"
                                       FontSize="15"
                                       TextColor="{StaticResource TextPrimary}"/>
                                <Label Text="Tự động kích hoạt khi khởi động app"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"/>
                            </VerticalStackLayout>
                            
                            <Switch x:Name="AutoProtectionSwitch"
                                   Grid.Column="2"
                                   IsToggled="True"
                                   OnColor="{StaticResource TealIcon}"
                                   ThumbColor="White"/>
                        </Grid>
                        
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" Margin="48,8,0,8"/>
                        
                        <!-- Dark Mode Toggle -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,8">
                            <Border WidthRequest="36" HeightRequest="36"
                                   BackgroundColor="{StaticResource AccentBlue20}"
                                   StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Label Text="🌙" FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            
                            <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                                <Label Text="Chế độ tối"
                                       FontSize="15"
                                       TextColor="{StaticResource TextPrimary}"/>
                                <Label Text="Giao diện tối cho mắt"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"/>
                            </VerticalStackLayout>
                            
                            <Switch x:Name="DarkModeSwitch"
                                   Grid.Column="2"
                                   IsToggled="True"
                                   OnColor="{StaticResource TealIcon}"
                                   ThumbColor="White"
                                   Toggled="OnDarkModeToggled"/>
                        </Grid>
                        
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" Margin="48,8,0,8"/>
                        
                        <!-- Language Selector -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,8">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLanguageClicked"/>
                            </Grid.GestureRecognizers>
                            
                            <Border WidthRequest="36" HeightRequest="36"
                                   BackgroundColor="#FBBF2420"
                                   StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Label Text="🌐" FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            
                            <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                                <Label Text="Ngôn ngữ"
                                       FontSize="15"
                                       TextColor="{StaticResource TextPrimary}"/>
                                <Label x:Name="LanguageLabel"
                                       Text="Tiếng Việt"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"/>
                            </VerticalStackLayout>
                            
                            <Label Grid.Column="2" Text="›"
                                   FontSize="20"
                                   TextColor="{StaticResource TextSecondary}"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- BẢO MẬT Section -->
            <VerticalStackLayout Spacing="8">
                <Label Text="BẢO MẬT"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextSecondary}"
                       Margin="4,8,0,0"/>
                
                <Border BackgroundColor="{StaticResource CardBg}"
                       StrokeThickness="0"
                       Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSecurityClicked"/>
                    </Border.GestureRecognizers>
                    
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,8">
                        <Border WidthRequest="36" HeightRequest="36"
                               BackgroundColor="#EF444420"
                               StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Label Text="🔐" FontSize="16"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        
                        <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                            <Label Text="Bảo mật tài khoản"
                                   FontSize="15"
                                   TextColor="#F87171"/>
                            <Label Text="Mật khẩu &amp; xác thực 2 bước"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                        
                        <Label Grid.Column="2" Text="›"
                               FontSize="20"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center"/>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- KẾT NỐI Section -->
            <VerticalStackLayout Spacing="8">
                <Label Text="KẾT NỐI"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextSecondary}"
                       Margin="4,8,0,0"/>
                
                <Border BackgroundColor="{StaticResource CardBg}"
                       StrokeThickness="0"
                       Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    
                    <VerticalStackLayout Spacing="12">
                        <!-- Server Status -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,8">
                            <Border WidthRequest="36" HeightRequest="36"
                                   BackgroundColor="{StaticResource AccentBlue20}"
                                   StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Label Text="🔗" FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            
                            <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                                <Label Text="Kết nối Server"
                                       FontSize="15"
                                       TextColor="{StaticResource TextPrimary}"/>
                                <HorizontalStackLayout Spacing="6">
                                    <Border x:Name="ServerStatusDot"
                                           WidthRequest="8" HeightRequest="8"
                                           BackgroundColor="{StaticResource SafeGreen}"
                                           StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="4"/>
                                        </Border.StrokeShape>
                                    </Border>
                                    <Label x:Name="ServerStatusLabel"
                                           Text=""
                                           FontSize="12"
                                           TextColor="{StaticResource SafeGreen}"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                        
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" Margin="0,4"/>
                        
                        <!-- USB Mode Toggle -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,8">
                            <Border WidthRequest="36" HeightRequest="36"
                                   BackgroundColor="#A855F720"
                                   StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Label Text="🔌" FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            
                            <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                                <Label Text="Chế độ USB"
                                       FontSize="15"
                                       TextColor="{StaticResource TextPrimary}"/>
                                <Label Text="Tự động kết nối khi cắm USB"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"/>
                            </VerticalStackLayout>
                            
                            <Switch x:Name="UsbModeSwitch"
                                   Grid.Column="2"
                                   OnColor="{StaticResource TealIcon}"
                                   ThumbColor="White"
                                   Toggled="OnUsbModeToggled"/>
                        </Grid>
                        
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" Margin="0,4"/>
                        
                        <!-- Server Address -->
                        <VerticalStackLayout Spacing="8">
                            <HorizontalStackLayout Spacing="12">
                                <Border WidthRequest="36" HeightRequest="36"
                                       BackgroundColor="#14B8A620"
                                       StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Label Text="🌐" FontSize="16"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>
                                <Label Text="Địa chỉ Server"
                                       FontSize="15"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            
                            <!-- Server URL Input -->
                            <Border BackgroundColor="{StaticResource InputBg}"
                                   StrokeThickness="1"
                                   Stroke="{StaticResource BorderColor}"
                                   Padding="4">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                
                                <Entry x:Name="ServerIPEntry"
                                       Placeholder="https://xxxx.ngrok-free.app"
                                       PlaceholderColor="#5C6B7A"
                                       TextColor="{StaticResource TextPrimary}"
                                       BackgroundColor="Transparent"
                                       FontSize="14"
                                       Keyboard="Url"
                                       Margin="12,8"/>
                            </Border>
                            
                            <!-- Hints -->
                            <Border BackgroundColor="{StaticResource InputBg}"
                                   StrokeThickness="0"
                                   Padding="12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                
                                <VerticalStackLayout Spacing="4">
                                    <Label FontSize="12" TextColor="{StaticResource TextSecondary}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="• Ngrok: "/>
                                                <Span Text="https://xxxx.ngrok-free.app" TextColor="{StaticResource SafeGreen}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label FontSize="12" TextColor="{StaticResource TextSecondary}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="• LAN: "/>
                                                <Span Text="http://192.168.1.12:8080" TextColor="{StaticResource AccentBlue}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                            </Border>
                            
                            <!-- Current Config -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Cấu hình hiện tại"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"/>
                                <Label x:Name="CurrentConfigLabel"
                                       Text=""
                                       FontSize="12"
                                       TextColor="{StaticResource AccentBlue}"/>
                            </VerticalStackLayout>
                            
                            <!-- Action Buttons -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                                <Button x:Name="SaveButton"
                                       Grid.Column="0"
                                       Text="💾 Lưu"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       BackgroundColor="{StaticResource TealIcon}"
                                       TextColor="#0D1B2A"
                                       CornerRadius="12"
                                       HeightRequest="44"
                                       Clicked="OnSaveButtonClicked"/>
                                
                                <Button x:Name="TestButton"
                                       Grid.Column="1"
                                       Text="🔍 Test"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       BackgroundColor="{StaticResource StatCardBg}"
                                       TextColor="{StaticResource TextPrimary}"
                                       CornerRadius="12"
                                       HeightRequest="44"
                                       Clicked="OnTestConnectionClicked"/>
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- TRỢ GIÚP Section -->
            <Border BackgroundColor="{StaticResource CardBg}"
                   StrokeThickness="0"
                   Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHelpClicked"/>
                </Border.GestureRecognizers>
                
                <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,8">
                    <Border WidthRequest="36" HeightRequest="36"
                           BackgroundColor="{StaticResource AccentBlue20}"
                           StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Label Text="❓" FontSize="16"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                    
                    <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                        <Label Text="Trợ giúp &amp; Hỗ trợ"
                               FontSize="15"
                               TextColor="{StaticResource TextPrimary}"/>
                        <Label Text="Nhận trợ giúp với FraudGuard"
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}"/>
                    </VerticalStackLayout>
                    
                    <Label Grid.Column="2" Text="›"
                           FontSize="20"
                           TextColor="{StaticResource TextSecondary}"
                           VerticalOptions="Center"/>
                </Grid>
            </Border>

            <!-- Logout Button -->
            <Border BackgroundColor="Transparent"
                   StrokeThickness="1"
                   Stroke="{StaticResource DangerRed}"
                   Padding="16"
                   Margin="0,16,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLogoutClicked"/>
                </Border.GestureRecognizers>
                
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                    <Label Text="🚪" FontSize="16" VerticalOptions="Center"/>
                    <Label Text="Đăng xuất"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{StaticResource DangerRed}"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>

            <!-- Version Info -->
            <Label Text="FraudGuard v1.0"
                   FontSize="12"
                   TextColor="{StaticResource TextSecondary}"
                   HorizontalOptions="Center"
                   Margin="0,16,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
