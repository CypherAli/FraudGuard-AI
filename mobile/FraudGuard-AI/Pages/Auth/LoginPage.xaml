<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FraudGuardAI.Pages.Auth.LoginPage"
             BackgroundColor="#0D1B2A"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <!-- Logo and Title -->
            <VerticalStackLayout Spacing="10" Margin="0,40,0,24">
                <Label Text="🛡️" FontSize="64" HorizontalOptions="Center"/>
                <Label Text="FraudGuard AI"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="#E0E6ED"
                       HorizontalOptions="Center"/>
                <Label Text="Bảo vệ cuộc gọi của bạn"
                       FontSize="16"
                       TextColor="#8B95A5"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Email Login Card -->
            <Frame BackgroundColor="#152234"
                   BorderColor="#1E2B3B"
                   CornerRadius="16"
                   Padding="16"
                   HasShadow="False">
                <VerticalStackLayout Spacing="6">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="✉️" FontSize="18" VerticalOptions="Center"/>
                        <Label Text="Đăng nhập bằng Email"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#34D399"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Label Text="Nhập email, chúng tôi sẽ gửi mã OTP 6 số để xác thực"
                           FontSize="12"
                           TextColor="#8B95A5"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Email Input -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Email của bạn"
                       TextColor="#E0E6ED"
                       FontSize="14"
                       FontAttributes="Bold"/>
                <Frame BackgroundColor="#1B2838"
                       BorderColor="#2D3E50"
                       CornerRadius="12"
                       Padding="0"
                       HasShadow="False">
                    <Entry x:Name="EmailEntry"
                           Placeholder="example@gmail.com"
                           PlaceholderColor="#5C6B7A"
                           TextColor="#E0E6ED"
                           Keyboard="Email"
                           FontSize="16"
                           Margin="15,10"/>
                </Frame>
            </VerticalStackLayout>

            <!-- Error Message -->
            <Label x:Name="ErrorLabel"
                   TextColor="#EF4444"
                   FontSize="14"
                   IsVisible="False"
                   HorizontalOptions="Center"/>

            <!-- Login Button -->
            <Button x:Name="LoginButton"
                    Text="Gửi mã OTP"
                    BackgroundColor="#34D399"
                    TextColor="#0D1B2A"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="56"
                    Margin="0,10,0,0"
                    Clicked="OnLoginClicked">
                <Button.Shadow>
                    <Shadow Brush="#34D399" Opacity="0.3" Radius="10" Offset="0,4"/>
                </Button.Shadow>
            </Button>

            <!-- Loading Indicator -->
            <ActivityIndicator x:Name="LoadingIndicator"
                             IsRunning="False"
                             IsVisible="False"
                             Color="#34D399"
                             HeightRequest="40"/>

            <!-- Info Text -->
            <VerticalStackLayout Spacing="6" Margin="0,10,0,0">
                <Label Text="🔒 Không cần mật khẩu"
                       TextColor="#8B95A5"
                       FontSize="12"
                       HorizontalOptions="Center"/>
                <Label Text="📱 Đăng nhập 1 lần, dùng mãi mãi"
                       TextColor="#8B95A5"
                       FontSize="12"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
