<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FraudGuardAI.Pages.Auth.LoginPage"
             xmlns:loc="clr-namespace:FraudGuardAI.Localization"
             BackgroundColor="#0D1B2A"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <!-- Logo and Title -->
            <VerticalStackLayout Spacing="10" Margin="0,40,0,24">
                <Label Text="🛡️" FontSize="64" HorizontalOptions="Center"/>
                  <Label Text="{loc:Translate Key=Login_Title}"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="#E0E6ED"
                       HorizontalOptions="Center"/>
                  <Label FontSize="16"
                      TextColor="#8B95A5"
                      HorizontalOptions="Center"
                      Text="{loc:Translate Key=Login_Subtitle}"/>
            </VerticalStackLayout>

            <!-- Email Login Card -->
            <Frame BackgroundColor="#152234"
                   BorderColor="#1E2B3B"
                   CornerRadius="16"
                   Padding="16"
                   HasShadow="False">
                <VerticalStackLayout Spacing="6">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="✉️" FontSize="18" VerticalOptions="Center"/>
                           <Label FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#34D399"
                               VerticalOptions="Center"
                               Text="{loc:Translate Key=Login_EmailLogin}"/>
                    </HorizontalStackLayout>
                          <Label FontSize="12"
                              TextColor="#8B95A5"
                              Text="{loc:Translate Key=Login_EmailDesc}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Email Input -->
            <VerticalStackLayout Spacing="8">
                  <Label TextColor="#E0E6ED"
                      FontSize="14"
                      FontAttributes="Bold"
                      Text="{loc:Translate Key=Login_YourEmail}"/>
                <Frame BackgroundColor="#1B2838"
                       BorderColor="#2D3E50"
                       CornerRadius="12"
                       Padding="0"
                       HasShadow="False">
                    <Entry x:Name="EmailEntry"
                           Placeholder="example@gmail.com"
                           PlaceholderColor="#5C6B7A"
                           TextColor="#E0E6ED"
                           Keyboard="Email"
                           FontSize="16"
                           Margin="15,10"/>
                </Frame>
            </VerticalStackLayout>

            <!-- Error Message -->
            <Label x:Name="ErrorLabel"
                   TextColor="#EF4444"
                   FontSize="14"
                   IsVisible="False"
                   HorizontalOptions="Center"/>

            <!-- Login Button -->
                <Button x:Name="LoginButton"
                    Text="{loc:Translate Key=Login_SendOtp}"
                    BackgroundColor="#34D399"
                    TextColor="#0D1B2A"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="56"
                    Margin="0,10,0,0"
                    Clicked="OnLoginClicked">
                <Button.Shadow>
                    <Shadow Brush="#34D399" Opacity="0.3" Radius="10" Offset="0,4"/>
                </Button.Shadow>
            </Button>

            <!-- Loading Indicator -->
            <ActivityIndicator x:Name="LoadingIndicator"
                             IsRunning="False"
                             IsVisible="False"
                             Color="#34D399"
                             HeightRequest="40"/>

            <!-- Forgot Access Link -->
            <Label Text="{loc:Translate Key=Login_ForgotAccess}"
                   TextColor="#60A5FA"
                   FontSize="14"
                   TextDecorations="Underline"
                   HorizontalOptions="Center"
                   Margin="0,4,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnForgotAccessClicked"/>
                </Label.GestureRecognizers>
            </Label>

            <!-- Info Text -->
            <VerticalStackLayout Spacing="6" Margin="0,10,0,0">
                  <Label TextColor="#8B95A5"
                      FontSize="12"
                      HorizontalOptions="Center"
                      Text="{loc:Translate Key=Login_InfoNoPassword}"/>
                  <Label TextColor="#8B95A5"
                      FontSize="12"
                      HorizontalOptions="Center"
                      Text="{loc:Translate Key=Login_InfoSingleLogin}"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

