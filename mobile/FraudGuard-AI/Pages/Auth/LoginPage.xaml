<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FraudGuardAI.Pages.Auth.LoginPage"
             xmlns:loc="clr-namespace:FraudGuardAI.Localization"
             BackgroundColor="{DynamicResource PageBackground}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,0,24,40" Spacing="0" VerticalOptions="Center">

            <!-- ══ Header ══ -->
            <VerticalStackLayout Spacing="6" Margin="0,64,0,40" HorizontalOptions="Center">
                <Label Text="FRAUDGUARD · V2.1"
                       FontSize="10" CharacterSpacing="2"
                       TextColor="#40FFFFFF" FontAttributes="Bold"
                       HorizontalOptions="Center"/>
                <Label Text="FraudGuard AI"
                       FontSize="36" FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"/>
                <Label Text="{loc:Translate Key=Login_Subtitle}"
                       FontSize="14" TextColor="#60FFFFFF"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- ══ Login Card ══ -->
            <Border StrokeThickness="1" Padding="24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0EFFFFFF" Offset="0"/>
                        <GradientStop Color="#000A0A0A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Stroke>
                    <SolidColorBrush Color="#12FFFFFF"/>
                </Border.Stroke>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="16">

                    <!-- Section label -->
                    <Label Text="{loc:Translate Key=Login_EmailLogin}"
                           FontSize="10" CharacterSpacing="2"
                           TextColor="#40FFFFFF" FontAttributes="Bold"/>

                    <!-- Email label -->
                    <Label Text="{loc:Translate Key=Login_YourEmail}"
                           FontSize="14" FontAttributes="Bold"
                           TextColor="White"/>

                    <!-- Email Input -->
                    <Border BackgroundColor="#08FFFFFF" StrokeThickness="1"
                            Stroke="#1A14B8A6" Padding="4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Entry x:Name="EmailEntry"
                               Placeholder="example@gmail.com"
                               PlaceholderColor="#40FFFFFF"
                               TextColor="White"
                               BackgroundColor="Transparent"
                               Keyboard="Email"
                               FontSize="15"
                               Margin="12,8"/>
                    </Border>

                    <!-- Error Message -->
                    <Label x:Name="ErrorLabel"
                           TextColor="#F87171"
                           FontSize="13"
                           IsVisible="False"
                           HorizontalOptions="Center"/>

                    <!-- Send OTP Button -->
                    <Button x:Name="LoginButton"
                            Text="{loc:Translate Key=Login_SendOtp}"
                            TextColor="White"
                            FontSize="16" FontAttributes="Bold"
                            CornerRadius="14"
                            HeightRequest="52"
                            Margin="0,4,0,0"
                            Clicked="OnLoginClicked">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F97316" Offset="0"/>
                                <GradientStop Color="#EA580C" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Shadow>
                            <Shadow Brush="#F97316" Opacity="0.3" Radius="12" Offset="0,4"/>
                        </Button.Shadow>
                    </Button>

                    <!-- Loading Indicator -->
                    <ActivityIndicator x:Name="LoadingIndicator"
                                       IsRunning="False"
                                       IsVisible="False"
                                       Color="#14B8A6"
                                       HeightRequest="36"
                                       HorizontalOptions="Center"/>

                </VerticalStackLayout>
            </Border>

            <!-- Can't access link -->
            <Label Text="{loc:Translate Key=Login_ForgotAccess}"
                   TextColor="#2DD4BF"
                   FontSize="13"
                   TextDecorations="Underline"
                   HorizontalOptions="Center"
                   Margin="0,20,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnForgotAccessClicked"/>
                </Label.GestureRecognizers>
            </Label>

            <!-- Info footer -->
            <VerticalStackLayout Spacing="4" Margin="0,24,0,0">
                <Label Text="{loc:Translate Key=Login_InfoNoPassword}"
                       TextColor="#30FFFFFF" FontSize="12"
                       HorizontalOptions="Center"/>
                <Label Text="{loc:Translate Key=Login_InfoSingleLogin}"
                       TextColor="#30FFFFFF" FontSize="12"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
