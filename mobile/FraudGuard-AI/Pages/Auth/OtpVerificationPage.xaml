<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FraudGuardAI.Pages.Auth.OtpVerificationPage"
             xmlns:loc="clr-namespace:FraudGuardAI.Localization"
             BackgroundColor="{DynamicResource PageBackground}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,0,24,40" Spacing="0">

            <!-- ══ Back ══ -->
            <Border BackgroundColor="Transparent" StrokeThickness="0"
                    HorizontalOptions="Start" Margin="0,52,0,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked"/>
                </Border.GestureRecognizers>
                <Label Text="← Quay lại"
                       TextColor="#2DD4BF" FontSize="14"
                       Padding="4"/>
            </Border>

            <!-- ══ Header ══ -->
            <VerticalStackLayout Spacing="6" Margin="0,28,0,32" HorizontalOptions="Center">
                <Label Text="FRAUDGUARD · V2.1"
                       FontSize="10" CharacterSpacing="2"
                       TextColor="#40FFFFFF" FontAttributes="Bold"
                       HorizontalOptions="Center"/>
                <Label Text="{loc:Translate Key=Otp_Title}"
                       FontSize="30" FontAttributes="Bold" TextColor="White"
                       HorizontalOptions="Center"/>
                <Label x:Name="PhoneLabel"
                       Text="{loc:Translate Key=Otp_SentToEmail}"
                       FontSize="13" TextColor="#60FFFFFF"
                       HorizontalOptions="Center"/>
                <Label x:Name="PhoneNumberLabel"
                       FontSize="15" FontAttributes="Bold"
                       TextColor="#2DD4BF"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- ══ OTP Card ══ -->
            <Border StrokeThickness="1" Padding="24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0EFFFFFF" Offset="0"/>
                        <GradientStop Color="#000A0A0A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Stroke>
                    <SolidColorBrush Color="#12FFFFFF"/>
                </Border.Stroke>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="20">

                    <!-- Section label -->
                    <Label Text="NHẬP MÃ XÁC THỰC"
                           FontSize="10" CharacterSpacing="2"
                           TextColor="#40FFFFFF" FontAttributes="Bold"
                           HorizontalOptions="Center"/>

                    <!-- OTP Input Row -->
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                        <!-- Box 1 -->
                        <Border BackgroundColor="#0EFFFFFF" StrokeThickness="1"
                                Stroke="#1A14B8A6" WidthRequest="44" HeightRequest="54">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Entry x:Name="Otp1" TextColor="White" FontSize="22" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                   BackgroundColor="Transparent" Keyboard="Numeric" MaxLength="1"
                                   TextChanged="OnOtpDigitChanged"/>
                        </Border>
                        <!-- Box 2 -->
                        <Border BackgroundColor="#0EFFFFFF" StrokeThickness="1"
                                Stroke="#1A14B8A6" WidthRequest="44" HeightRequest="54">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Entry x:Name="Otp2" TextColor="White" FontSize="22" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                   BackgroundColor="Transparent" Keyboard="Numeric" MaxLength="1"
                                   TextChanged="OnOtpDigitChanged"/>
                        </Border>
                        <!-- Box 3 -->
                        <Border BackgroundColor="#0EFFFFFF" StrokeThickness="1"
                                Stroke="#1A14B8A6" WidthRequest="44" HeightRequest="54">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Entry x:Name="Otp3" TextColor="White" FontSize="22" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                   BackgroundColor="Transparent" Keyboard="Numeric" MaxLength="1"
                                   TextChanged="OnOtpDigitChanged"/>
                        </Border>
                        <!-- Box 4 -->
                        <Border BackgroundColor="#0EFFFFFF" StrokeThickness="1"
                                Stroke="#1A14B8A6" WidthRequest="44" HeightRequest="54">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Entry x:Name="Otp4" TextColor="White" FontSize="22" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                   BackgroundColor="Transparent" Keyboard="Numeric" MaxLength="1"
                                   TextChanged="OnOtpDigitChanged"/>
                        </Border>
                        <!-- Box 5 -->
                        <Border BackgroundColor="#0EFFFFFF" StrokeThickness="1"
                                Stroke="#1A14B8A6" WidthRequest="44" HeightRequest="54">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Entry x:Name="Otp5" TextColor="White" FontSize="22" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                   BackgroundColor="Transparent" Keyboard="Numeric" MaxLength="1"
                                   TextChanged="OnOtpDigitChanged"/>
                        </Border>
                        <!-- Box 6 -->
                        <Border BackgroundColor="#0EFFFFFF" StrokeThickness="1"
                                Stroke="#1A14B8A6" WidthRequest="44" HeightRequest="54">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Entry x:Name="Otp6" TextColor="White" FontSize="22" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                   BackgroundColor="Transparent" Keyboard="Numeric" MaxLength="1"
                                   TextChanged="OnOtpDigitChanged"/>
                        </Border>
                    </HorizontalStackLayout>

                    <!-- Error Message -->
                    <Label x:Name="ErrorLabel"
                           TextColor="#F87171" FontSize="13"
                           IsVisible="False"
                           HorizontalOptions="Center"/>

                    <!-- Verify Button -->
                    <Button x:Name="VerifyButton"
                            Text="{loc:Translate Key=Otp_Verify}"
                            TextColor="White"
                            FontSize="16" FontAttributes="Bold"
                            CornerRadius="14" HeightRequest="52"
                            Clicked="OnVerifyClicked">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#14B8A6" Offset="0"/>
                                <GradientStop Color="#0D9488" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Shadow>
                            <Shadow Brush="#14B8A6" Opacity="0.25" Radius="12" Offset="0,4"/>
                        </Button.Shadow>
                    </Button>

                    <!-- Loading Indicator -->
                    <ActivityIndicator x:Name="LoadingIndicator"
                                       IsRunning="False" IsVisible="False"
                                       Color="#14B8A6" HeightRequest="36"
                                       HorizontalOptions="Center"/>

                    <!-- Resend -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                        <Label Text="{loc:Translate Key=Otp_NoCode}"
                               TextColor="#50FFFFFF" FontSize="13"/>
                        <Label x:Name="ResendLabel"
                               Text="{loc:Translate Key=Otp_Resend}"
                               TextColor="#2DD4BF" FontSize="13" FontAttributes="Bold">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnResendTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <!-- Countdown -->
                    <Label x:Name="CountdownLabel"
                           TextColor="#40FFFFFF" FontSize="12"
                           HorizontalOptions="Center"
                           IsVisible="False"/>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
