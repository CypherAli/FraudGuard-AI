<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FraudGuardAI.Pages.Auth.RegisterPage"
             xmlns:loc="clr-namespace:FraudGuardAI.Localization"
             BackgroundColor="#0D1B2A"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <!-- Back Button -->
            <Button Text="{loc:Translate Key=Register_Back}"
                    BackgroundColor="Transparent"
                    TextColor="#34D399"
                    FontSize="16"
                    HorizontalOptions="Start"
                    Clicked="OnBackClicked"
                    Margin="0,20,0,0"/>

            <!-- Title -->
            <VerticalStackLayout Spacing="10" Margin="0,20,0,30">
                <Label Text="{loc:Translate Key=Register_Title}"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="#E0E6ED"
                       HorizontalOptions="Center"/>
                <Label Text="{loc:Translate Key=Register_Subtitle}"
                       FontSize="16"
                       TextColor="#8B95A5"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- OTP Info Banner -->
            <Border BackgroundColor="#0F2D1F"
                    StrokeThickness="1"
                    Stroke="#34D399"
                    Padding="16,12">
                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                <HorizontalStackLayout Spacing="10">
                    <Label Text="✉️" FontSize="20" VerticalOptions="Center"/>
                    <Label Text="{loc:Translate Key=Register_OtpInfo}"
                           FontSize="13"
                           TextColor="#34D399"
                           VerticalOptions="Center"
                           LineBreakMode="WordWrap"/>
                </HorizontalStackLayout>
            </Border>

            <!-- Phone Number Input -->
            <VerticalStackLayout Spacing="8">
                <Label TextColor="#E0E6ED"
                       FontSize="14"
                       FontAttributes="Bold"
                       Text="{loc:Translate Key=Register_Phone}"/>
                <Frame BackgroundColor="#1B2838"
                       BorderColor="#2D3E50"
                       CornerRadius="12"
                       Padding="0"
                       HasShadow="False">
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0"
                               Text="📱"
                               FontSize="18"
                               VerticalOptions="Center"
                               Margin="14,0,0,0"/>
                        <Entry x:Name="PhoneEntry"
                               Grid.Column="1"
                               Placeholder="+84 xxx xxx xxx"
                               PlaceholderColor="#5C6B7A"
                               TextColor="#E0E6ED"
                               Keyboard="Telephone"
                               FontSize="16"
                               Margin="10,12"/>
                    </Grid>
                </Frame>
            </VerticalStackLayout>

            <!-- Terms Checkbox -->
            <HorizontalStackLayout Spacing="10" Margin="0,10,0,0">
                <CheckBox x:Name="TermsCheckbox"
                          Color="#34D399"/>
                <Label TextColor="#8B95A5" FontSize="13" VerticalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{loc:Translate Key=Register_TermsPrefix}"/>
                            <Span Text="{loc:Translate Key=Register_Terms}" TextColor="#34D399" TextDecorations="Underline"/>
                            <Span Text="{loc:Translate Key=Register_And}"/>
                            <Span Text="{loc:Translate Key=Register_Privacy}" TextColor="#34D399" TextDecorations="Underline"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </HorizontalStackLayout>

            <!-- Error Message -->
            <Label x:Name="ErrorLabel"
                   TextColor="#EF4444"
                   FontSize="14"
                   IsVisible="False"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>

            <!-- Register Button -->
            <Button x:Name="RegisterButton"
                    Text="{loc:Translate Key=Register_Button}"
                    BackgroundColor="#34D399"
                    TextColor="#0D1B2A"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="56"
                    Margin="0,10,0,0"
                    Clicked="OnRegisterClicked">
                <Button.Shadow>
                    <Shadow Brush="#34D399" Opacity="0.3" Radius="10" Offset="0,4"/>
                </Button.Shadow>
            </Button>

            <!-- Loading Indicator -->
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="#34D399"
                               HeightRequest="40"/>

            <!-- Login Link -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,16,0,20">
                <Label TextColor="#8B95A5"
                       FontSize="14"
                       Text="{loc:Translate Key=Register_HaveAccount}"/>
                <Label Text="{loc:Translate Key=Register_Login}"
                       TextColor="#34D399"
                       FontSize="14"
                       FontAttributes="Bold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLoginTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
