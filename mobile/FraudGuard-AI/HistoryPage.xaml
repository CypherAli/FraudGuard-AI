<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FraudGuardAI.Models"
             xmlns:loc="clr-namespace:FraudGuardAI.Localization"
             x:Class="FraudGuardAI.Pages.HistoryPage"
             Title="{loc:Translate Key=Tab_History}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*" Padding="20,48,20,20">
        
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="8" Margin="0,0,0,24">
                 <Label FontSize="26"
                     FontAttributes="Bold"
                     TextColor="{DynamicResource TextPrimary}"
                     HorizontalOptions="Start"
                     Text="{loc:Translate Key=History_Title}"/>
            
            <Label x:Name="SubtitleLabel"
                     Text="{loc:Translate Key=History_Subtitle}"
                   FontSize="14"
                   TextColor="{DynamicResource TextSecondary}"/>
        </VerticalStackLayout>

        <!-- Content -->
        <RefreshView x:Name="RefreshView"
                     Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}"
                     RefreshColor="{StaticResource PrimaryBlue}">
            
            <Grid>
                <!-- Loading -->
                <ActivityIndicator x:Name="LoadingIndicator"
                                  IsRunning="False"
                                  IsVisible="False"
                                  Color="{StaticResource PrimaryBlue}"
                                  VerticalOptions="Center"
                                  HorizontalOptions="Center"
                                  WidthRequest="48"
                                  HeightRequest="48"/>

                <!-- Empty State -->
                <VerticalStackLayout x:Name="EmptyStateView"
                                    IsVisible="False"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center"
                                    Spacing="16">
                    
                    <Border WidthRequest="80"
                           HeightRequest="80"
                           BackgroundColor="{DynamicResource CardBackground}"
                           StrokeThickness="0"
                           HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="40"/>
                        </Border.StrokeShape>
                        <Label Text="📋"
                               FontSize="36"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                    
                          <Label FontSize="18"
                              FontAttributes="Bold"
                              TextColor="{DynamicResource TextPrimary}"
                              HorizontalOptions="Center"
                              Text="{loc:Translate Key=History_EmptyTitle}"/>
                    
                          <Label FontSize="14"
                              TextColor="{DynamicResource TextSecondary}"
                              HorizontalOptions="Center"
                              Text="{loc:Translate Key=History_EmptySubtitle}"/>
                </VerticalStackLayout>

                <!-- Call List -->
                <CollectionView x:Name="HistoryCollectionView"
                               ItemsSource="{Binding CallLogs}"
                               SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CallLog">
                            <Border BackgroundColor="{DynamicResource CardBg}"
                                   StrokeThickness="0"
                                   Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#000000"
                                           Opacity="0.2"
                                           Radius="12"
                                           Offset="0,4"/>
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCallLogTapped" CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                    
                                    <!-- Risk Badge -->
                                    <Border Grid.Row="0" Grid.Column="0"
                                           BackgroundColor="{Binding RiskScoreColor}"
                                           Padding="12,6"
                                           HorizontalOptions="Start"
                                           StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Label Text="{Binding RiskLevelDisplay}"
                                              FontSize="12"
                                              FontAttributes="Bold"
                                              TextColor="White"/>
                                    </Border>

                                    <!-- Risk Score -->
                                    <Border Grid.Row="0" Grid.Column="1"
                                           BackgroundColor="{Binding RiskScoreColor}"
                                           Padding="12,8"
                                           StrokeThickness="0"
                                           Opacity="0.2">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10"/>
                                        </Border.StrokeShape>
                                    </Border>
                                    <Label Grid.Row="0" Grid.Column="1"
                                          Text="{Binding RiskScore, StringFormat='{0}%'}"
                                          FontSize="20"
                                          FontAttributes="Bold"
                                          TextColor="{Binding RiskScoreColor}"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"/>

                                    <!-- Time & Duration -->
                                    <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="12">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="🕐" FontSize="12"/>
                                            <Label Text="{Binding TimeDisplay}"
                                                  FontSize="13"
                                                  TextColor="{DynamicResource TextSecondary}"/>
                                        </HorizontalStackLayout>
                                        <Label Text="•" TextColor="{DynamicResource TextSecondary}" FontSize="13"/>
                                        <Label Text="{Binding DurationDisplay}"
                                              FontSize="13"
                                              TextColor="{DynamicResource TextSecondary}"/>
                                    </HorizontalStackLayout>

                                    <!-- Evidence -->
                                    <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="4">
                                            <Label FontSize="11"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource TextSecondary}"
                                                Opacity="0.8"
                                                Text="{loc:Translate Key=History_Evidence}"/>
                                        <Label Text="{Binding Evidence}"
                                              FontSize="13"
                                              TextColor="{DynamicResource TextPrimary}"
                                              LineBreakMode="TailTruncation"
                                              MaxLines="2"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Error State -->
                <VerticalStackLayout x:Name="ErrorView"
                                    IsVisible="False"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center"
                                    Spacing="16">
                    
                    <Border WidthRequest="80"
                           HeightRequest="80"
                           BackgroundColor="#7F1D1D"
                           StrokeThickness="0"
                           HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="40"/>
                        </Border.StrokeShape>
                        <Label Text="✕"
                               FontSize="32"
                               TextColor="#F87171"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                    
                    <Label x:Name="ErrorMessageLabel"
                              Text="{loc:Translate Key=History_Error}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource DangerRed}"
                           HorizontalOptions="Center"/>
                    
                          <Button Text="{loc:Translate Key=History_Retry}"
                           FontSize="15"
                           BackgroundColor="{StaticResource AccentBlue}"
                           TextColor="White"
                           CornerRadius="24"
                           Padding="32,12"
                           Clicked="OnRetryClicked"/>
                </VerticalStackLayout>
            </Grid>
        </RefreshView>
    </Grid>
</ContentPage>

