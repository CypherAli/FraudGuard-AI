<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FraudGuardAI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FraudGuardAI"
    xmlns:pages="clr-namespace:FraudGuardAI.Pages"
    xmlns:loc="clr-namespace:FraudGuardAI.Localization"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Shell.TabBarBackgroundColor="#0A0A0A"
    Shell.TabBarForegroundColor="#F97316"
    Shell.TabBarUnselectedColor="#60FFFFFF"
    Shell.TabBarTitleColor="#F97316">

    <Shell.Resources>
        <ResourceDictionary>
            <Style TargetType="TabBar">
                <Setter Property="Shell.TabBarBackgroundColor" Value="#0A0A0A"/>
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <TabBar>
        <ShellContent
            Title="{loc:Translate Key=Tab_Protection}"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage"/>

        <ShellContent
            Title="{loc:Translate Key=Tab_History}"
            ContentTemplate="{DataTemplate pages:HistoryPage}"
            Route="HistoryPage"/>

        <ShellContent
            Title="{loc:Translate Key=Tab_Settings}"
            ContentTemplate="{DataTemplate pages:SettingsPage}"
            Route="SettingsPage"/>
    </TabBar>

</Shell>
