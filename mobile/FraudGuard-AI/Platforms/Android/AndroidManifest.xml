<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application 
        android:allowBackup="true" 
        android:icon="@mipmap/appicon" 
        android:roundIcon="@mipmap/appicon_round" 
        android:supportsRtl="true"
        android:label="FraudGuard AI"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">
        
        <!-- Foreground Service để chạy ngầm khi màn hình tắt -->
        <!-- foregroundServiceType="microphone": AudioRecord (MIC + PSTN-SCO via Bluetooth SCO) -->
        <service
            android:name=".Platforms.Android.Services.FraudGuardForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Overlay bubble service -->
        <service
            android:name=".Platforms.Android.Services.OverlayService"
            android:enabled="true"
            android:exported="false" />

        <!-- BroadcastReceiver xử lý nút [Xác nhận chặn] / [Bỏ qua] từ pending_report notification -->
        <receiver
            android:name=".Platforms.Android.Services.ReportConfirmReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.fraudguard.ACTION_CONFIRM_REPORT" />
                <action android:name="com.fraudguard.ACTION_IGNORE_REPORT" />
            </intent-filter>
        </receiver>
    </application>
    
    <!-- Quyền ghi âm (BẮT BUỘC) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Quyền đọc trạng thái cuộc gọi (tự động phát hiện cuộc gọi đến) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Android 11+ (API 33+): explicit permission to read SIM phone number -->
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />

    <!-- Quyền Internet (BẮT BUỘC cho WebSocket) -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- Quyền truy cập mạng -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Quyền ghi file (cho audio recording) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" 
                     android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" 
                     android:maxSdkVersion="32" />
    
    <!-- Android 13+ storage permissions -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    
    <!-- Foreground Service (nếu cần chạy background) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    
    <!-- Wake Lock (giữ app không sleep khi recording) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- Vibration (cho cảnh báo nguy hiểm) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    
    <!-- Full screen intent (hiển thị cảnh báo khi màn hình khóa) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    
    <!-- Android 13+ Post notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- Overlay permission (floating bubble during calls) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Read contacts (whitelist import) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Answer/reject phone calls (auto-reject blacklisted) -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

    <!-- Receive SMS (SMS fraud detection) -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- Bluetooth SCO / Virtual HFP — route PSTN call audio to AudioRecord -->
    <!-- MODIFY_AUDIO_SETTINGS: needed to set AudioManager mode (IN_CALL) and BluetoothScoOn -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- BLUETOOTH: needed on API < 31 to start Bluetooth SCO -->
    <uses-permission android:name="android.permission.BLUETOOTH"
                     android:maxSdkVersion="30" />
    <!-- BLUETOOTH_CONNECT: required on API 31+ (Android 12) for startBluetoothSco() -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Khai báo audio recording feature -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />
</manifest>
