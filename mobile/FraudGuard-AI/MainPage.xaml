<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FraudGuardAI.MainPage"
             xmlns:loc="clr-namespace:FraudGuardAI.Localization"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Padding="20,48,20,20">
        
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Border WidthRequest="32" HeightRequest="32" 
                            BackgroundColor="{StaticResource CyanAccent}"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Label Text="🛡" FontSize="16" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center"/>
                    </Border>
                          <Label Text="FraudGuard AI" 
                           FontSize="20" 
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
                
                <!-- Progress Bar -->
                <Border Grid.Column="1" 
                        HeightRequest="4" 
                        BackgroundColor="{StaticResource ProgressBarBg}"
                        Margin="16,0"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="2"/>
                    </Border.StrokeShape>
                </Border>
                
                  <Label Grid.Column="2"
                      IsVisible="False"/>
            </Grid>
            
            <!-- Title Section -->
            <VerticalStackLayout Grid.Row="1" Spacing="4" Margin="0,16,0,16">
                  <Label FontSize="28"
                      FontAttributes="Bold"
                      TextColor="{DynamicResource TextPrimary}"
                      Text="{loc:Translate Key=Main_Dashboard}"/>
                
                  <Label FontSize="14"
                      TextColor="{DynamicResource TextSecondary}"
                      Text="{loc:Translate Key=Main_DashboardSubtitle}"/>
                
                <!-- Report Button -->
                <Button x:Name="ReportButton"
                    Text="{loc:Translate Key=Main_ReportNumber}"
                        FontSize="14"
                        FontAttributes="Bold"
                        BackgroundColor="{StaticResource OrangeIcon}"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="40"
                        HorizontalOptions="Start"
                        Padding="16,0"
                        Margin="0,12,0,0"
                        Clicked="OnReportButtonClicked"/>
            </VerticalStackLayout>
            
            <!-- Protection Status Card -->
            <Border Grid.Row="2" 
                    BackgroundColor="{DynamicResource CardBg}"
                    StrokeThickness="0"
                    Padding="24"
                    Margin="0,8,0,16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000" Opacity="0.3" Radius="20" Offset="0,8"/>
                </Border.Shadow>
                
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <!-- Shield Icon with Glow -->
                    <Border x:Name="ShieldBorder"
                            WidthRequest="80"
                            HeightRequest="80"
                            BackgroundColor="#1E3A4D"
                            StrokeThickness="2"
                            Stroke="{StaticResource TealIcon}"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="40"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource TealIcon}" Opacity="0.4" Radius="20"/>
                        </Border.Shadow>
                        
                        <Grid>
                            <Label x:Name="ProtectionIconLabel"
                                   Text="✓"
                                   FontSize="32"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                    
                    <Label x:Name="ProtectionStatusLabel"
                              Text="{loc:Translate Key=Main_ProtectionOff}"
                           FontSize="12"
                           TextColor="{DynamicResource TextSecondary}"
                           HorizontalOptions="Center"/>
                    
                    <Label x:Name="StatusLabel"
                              Text="{loc:Translate Key=Main_ProtectionInactive}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}"
                           HorizontalOptions="Center"/>
                    
                    <Label x:Name="BlockRateLabel"
                              Text="{loc:Translate Key=Main_NoData}"
                           FontSize="14"
                           TextColor="{DynamicResource TextSecondary}"
                           HorizontalOptions="Center"/>
                    
                    <!-- Toggle Protection Button -->
                    <Button x:Name="ToggleProtectionButton"
                            Text="{loc:Translate Key=Main_EnableProtection}"
                            FontSize="14"
                            FontAttributes="Bold"
                            BackgroundColor="{StaticResource CyanAccent}"
                            TextColor="White"
                            CornerRadius="20"
                            HeightRequest="44"
                            WidthRequest="180"
                            HorizontalOptions="Center"
                            Margin="0,8,0,0"
                            Clicked="OnToggleProtectionClicked"/>
                </VerticalStackLayout>
            </Border>
            
            <!-- Stats Cards Grid -->
            <Grid Grid.Row="3" 
                  ColumnDefinitions="*,*" 
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="12"
                  Margin="0,0,0,16">
                
                <!-- Card 1: Số đã chặn -->
                <Border Grid.Row="0" Grid.Column="0"
                        BackgroundColor="{DynamicResource StatCardBg}"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <HorizontalStackLayout Spacing="8">
                            <Label FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextSecondary}"
                                Text="{loc:Translate Key=Main_BlockedCount}"/>
                        </HorizontalStackLayout>
                        
                        <Label Grid.Row="1" x:Name="BlockedTotalLabel"
                               Text="0"
                               FontSize="36"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}"/>
                        
                        <Label Grid.Row="2" x:Name="WeeklyChangeLabel"
                               Text=""
                               IsVisible="False"
                               FontSize="12"
                               TextColor="{StaticResource TealIcon}"/>
                    </Grid>
                </Border>
                
                <!-- Card 2: Chặn hôm nay -->
                <Border Grid.Row="0" Grid.Column="1"
                        BackgroundColor="{DynamicResource StatCardBg}"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                        <HorizontalStackLayout Spacing="8">
                            <Label FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextSecondary}"
                                Text="{loc:Translate Key=Main_BlockedToday}"/>
                        </HorizontalStackLayout>
                        
                        <Label Grid.Row="1" x:Name="BlockedTodayLabel"
                               Text="0"
                               FontSize="36"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}"/>
                    </Grid>
                </Border>
                
                <!-- Card 3: Mối đe dọa nghiêm trọng -->
                <Border Grid.Row="1" Grid.Column="0"
                        BackgroundColor="{DynamicResource StatCardBg}"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                        <HorizontalStackLayout Spacing="8">
                            <Label FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextSecondary}"
                                LineBreakMode="TailTruncation"
                                Text="{loc:Translate Key=Main_SevereThreats}"/>
                        </HorizontalStackLayout>
                        
                        <Label Grid.Row="1" x:Name="ThreatsLabel"
                               Text="0"
                               FontSize="36"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}"/>
                    </Grid>
                </Border>
                
                <!-- Card 4: Hiệu quả bảo vệ -->
                <Border Grid.Row="1" Grid.Column="1"
                        BackgroundColor="{DynamicResource StatCardBg}"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <HorizontalStackLayout Spacing="8">
                            <Label FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextSecondary}"
                                Text="{loc:Translate Key=Main_Effectiveness}"/>
                        </HorizontalStackLayout>
                        
                        <Label Grid.Row="1" x:Name="EfficiencyLabel"
                               Text="0%"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}"/>
                        
                        <Label Grid.Row="2" x:Name="EfficiencyChangeLabel"
                               Text=""
                               IsVisible="False"
                               FontSize="12"
                               TextColor="{StaticResource TealIcon}"/>
                    </Grid>
                </Border>
            </Grid>
            
            <!-- Recent Calls Section -->
            <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,8,0,12">
                  <Label FontSize="16"
                      FontAttributes="Bold"
                      TextColor="{DynamicResource TextPrimary}"
                      VerticalOptions="Center"
                      Text="{loc:Translate Key=Main_RecentCalls}"/>
                
                <HorizontalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="🕐" FontSize="12" VerticalOptions="Center"/>
                          <Label FontSize="13"
                              TextColor="{DynamicResource TextSecondary}"
                              VerticalOptions="Center"
                              Text="{loc:Translate Key=Main_Today}"/>
                </HorizontalStackLayout>
            </Grid>
            
            <!-- Recent Calls List (Placeholder) -->
            <VerticalStackLayout Grid.Row="5" x:Name="RecentCallsContainer">
                <Border BackgroundColor="{DynamicResource StatCardBg}"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label FontSize="14"
                               TextColor="{DynamicResource TextSecondary}"
                               HorizontalOptions="Center"
                               Text="{loc:Translate Key=Main_NoCalls}"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
            
            <!-- Alert Banner (Hidden by default) -->
            <Border x:Name="AlertBanner"
                    Grid.Row="5"
                    IsVisible="False"
                    BackgroundColor="{StaticResource DangerBackground}"
                    Padding="20,16"
                    Margin="0,12,0,0"
                    StrokeThickness="1"
                    Stroke="{StaticResource GlowRed}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                
                <Grid ColumnDefinitions="Auto,*">
                    <Border WidthRequest="44"
                           HeightRequest="44"
                           BackgroundColor="#F8717130"
                           StrokeThickness="0"
                           VerticalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22"/>
                        </Border.StrokeShape>
                        <Label Text="⚠"
                               FontSize="22"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                    
                    <VerticalStackLayout Grid.Column="1" Spacing="4" Margin="14,0,0,0">
                        <Label x:Name="AlertTypeLabel"
                               Text=""
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#FCA5A5"/>
                        <Label x:Name="AlertMessageLabel"
                               Text=""
                               FontSize="13"
                               TextColor="#FECACA"
                               LineBreakMode="TailTruncation"/>
                        <Label x:Name="AlertConfidenceLabel"
                               Text=""
                               FontSize="12"
                               TextColor="#FCA5A5"
                               Opacity="0.8"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>

