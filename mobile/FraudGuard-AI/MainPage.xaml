<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:FraudGuardAI.Localization"
             x:Class="FraudGuardAI.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource PageBackground}">

    <Grid>
        <ScrollView>
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*"
                  Padding="16,52,16,100"
                  RowSpacing="12">

                <!-- ══ Row 0: Header ══ -->
                <VerticalStackLayout Grid.Row="0" Spacing="2" Margin="0,0,0,6">
                    <Label Text="FRAUDGUARD · V2.1"
                           FontSize="10" CharacterSpacing="2"
                           TextColor="{AppThemeBinding Light=#808B9CAF, Dark=#40FFFFFF}"
                           FontAttributes="Bold"/>
                    <Label Text="Dashboard"
                           FontSize="36" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1B2530, Dark=White}"/>
                    <Label Text="Monitor and manage scam calls"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#5A6B7A, Dark=#60FFFFFF}"/>
                </VerticalStackLayout>

                <!-- ══ Row 1: Status Card (Radar + Info) ══ -->
                <Border x:Name="ShieldBorder" Grid.Row="1"
                        StrokeThickness="1" Padding="16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1414B8A6" Offset="0"/>
                            <GradientStop Color="#000A0A0A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Stroke>
                        <SolidColorBrush Color="#3314B8A6"/>
                    </Border.Stroke>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#14B8A6" Opacity="0.2" Radius="24" Offset="0,4"/>
                    </Border.Shadow>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                        <!-- Left: Radar Canvas with outer glow container -->
                        <Grid Grid.Column="0" WidthRequest="168" HeightRequest="168"
                              VerticalOptions="Center" HorizontalOptions="Center">
                            <GraphicsView x:Name="RadarView"
                                          WidthRequest="168" HeightRequest="168"
                                          VerticalOptions="Center" HorizontalOptions="Center"/>
                        </Grid>

                        <!-- Right: Status Info -->
                        <VerticalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">

                            <!-- Status badge: dot + label -->
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <BoxView x:Name="SystemStatusDot"
                                         WidthRequest="8" HeightRequest="8"
                                         CornerRadius="4" Color="#2DD4BF"
                                         VerticalOptions="Center"/>
                                <Label x:Name="ProtectionStatusLabel"
                                       FontSize="10" FontAttributes="Bold"
                                       CharacterSpacing="1.5" TextColor="#2DD4BF"/>
                            </HorizontalStackLayout>

                            <!-- Main heading ("You're protected") -->
                            <Label x:Name="StatusLabel"
                                   FontSize="20" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#1B2530, Dark=White}" LineBreakMode="WordWrap"/>

                            <!-- Sub-text -->
                            <Label x:Name="BlockRateLabel"
                                   FontSize="12" TextColor="{AppThemeBinding Light=#5A6B7A, Dark=#60FFFFFF}"
                                   LineBreakMode="WordWrap"/>

                            <!-- Enable / Disable button -->
                            <Button x:Name="ToggleProtectionButton"
                                    FontSize="12" FontAttributes="Bold"
                                    TextColor="#2DD4BF" BackgroundColor="Transparent"
                                    BorderColor="#2DD4BF" BorderWidth="1"
                                    CornerRadius="20" HeightRequest="34"
                                    HorizontalOptions="Start" Padding="16,0"
                                    Clicked="OnToggleProtectionClicked"/>

                            <!-- Hidden: preserved for code-behind compatibility -->
                            <Label x:Name="ProtectionIconLabel" IsVisible="False"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- ══ Row 2: Report Button ══ -->
                <Button x:Name="ReportButton" Grid.Row="2"
                        Text="+ Report new number"
                        FontSize="14" FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light=#1B2530, Dark=White}" CornerRadius="16" HeightRequest="54"
                        HorizontalOptions="Fill"
                        Clicked="OnReportButtonClicked">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#F97316" Offset="0"/>
                            <GradientStop Color="#EA580C" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Shadow>
                        <Shadow Brush="#F97316" Opacity="0.3" Radius="16" Offset="0,4"/>
                    </Button.Shadow>
                </Button>

                <!-- ══ Row 3: Live Statistics label ══ -->
                <Label Grid.Row="3" Text="LIVE STATISTICS"
                       FontSize="10" CharacterSpacing="2"
                       TextColor="{AppThemeBinding Light=#5A6B7A, Dark=#40FFFFFF}"
                       FontAttributes="Bold"
                       Margin="2,4,0,0"/>

                <!-- ══ Row 4: Stats Grid ══ -->
                <Grid Grid.Row="4"
                      ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                      ColumnSpacing="10" RowSpacing="10">

                    <!-- Blocked Total -->
                    <Border Grid.Row="0" Grid.Column="0"
                            BackgroundColor="{AppThemeBinding Light=#EEF4FF, Dark=#0EFFFFFF}"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#C7D8F0, Dark=#12FFFFFF}"
                            Padding="16,14">
                        <Border.StrokeShape><RoundRectangle CornerRadius="18"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="BLOCKED" FontSize="10" CharacterSpacing="1.5"
                                   TextColor="{AppThemeBinding Light=#5A6B7A, Dark=#50FFFFFF}"
                                   FontAttributes="Bold"/>
                            <Label x:Name="BlockedTotalLabel" Text="0"
                                   FontSize="32" FontAttributes="Bold" TextColor="#A78BFA"/>
                            <Label x:Name="WeeklyChangeLabel" IsVisible="False"
                                   FontSize="11" TextColor="#14B8A6"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Blocked Today -->
                    <Border Grid.Row="0" Grid.Column="1"
                            BackgroundColor="{AppThemeBinding Light=#EEF4FF, Dark=#0EFFFFFF}"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#C7D8F0, Dark=#12FFFFFF}"
                            Padding="16,14">
                        <Border.StrokeShape><RoundRectangle CornerRadius="18"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="TODAY" FontSize="10" CharacterSpacing="1.5"
                                   TextColor="{AppThemeBinding Light=#5A6B7A, Dark=#50FFFFFF}"
                                   FontAttributes="Bold"/>
                            <Label x:Name="BlockedTodayLabel" Text="0"
                                   FontSize="32" FontAttributes="Bold" TextColor="#818CF8"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Threats -->
                    <Border Grid.Row="1" Grid.Column="0"
                            BackgroundColor="{AppThemeBinding Light=#EEF4FF, Dark=#0EFFFFFF}"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#C7D8F0, Dark=#12FFFFFF}"
                            Padding="16,14">
                        <Border.StrokeShape><RoundRectangle CornerRadius="18"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="THREATS" FontSize="10" CharacterSpacing="1.5"
                                   TextColor="{AppThemeBinding Light=#5A6B7A, Dark=#50FFFFFF}"
                                   FontAttributes="Bold"/>
                            <Label x:Name="ThreatsLabel" Text="0"
                                   FontSize="32" FontAttributes="Bold" TextColor="#F87171"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Effectiveness -->
                    <Border Grid.Row="1" Grid.Column="1"
                            BackgroundColor="{AppThemeBinding Light=#EEF4FF, Dark=#0EFFFFFF}"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#C7D8F0, Dark=#12FFFFFF}"
                            Padding="16,14">
                        <Border.StrokeShape><RoundRectangle CornerRadius="18"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="EFFECTIVENESS" FontSize="9" CharacterSpacing="1"
                                   TextColor="{AppThemeBinding Light=#5A6B7A, Dark=#50FFFFFF}"
                                   FontAttributes="Bold"/>
                            <Label x:Name="EfficiencyLabel" Text="0.0%"
                                   FontSize="28" FontAttributes="Bold" TextColor="#2DD4BF"/>
                            <Label x:Name="EfficiencyChangeLabel" IsVisible="False"
                                   FontSize="11" TextColor="#14B8A6"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- ══ Row 5: AI Audio Analysis ══ -->
                <Border Grid.Row="5"
                        BackgroundColor="{AppThemeBinding Light=#EEF4FF, Dark=#08FFFFFF}"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#C7D8F0, Dark=#0CFFFFFF}"
                        Padding="16,14">
                    <Border.StrokeShape><RoundRectangle CornerRadius="18"/></Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="AI AUDIO ANALYSIS"
                               FontSize="10" CharacterSpacing="2"
                               TextColor="{AppThemeBinding Light=#5A6B7A, Dark=#40FFFFFF}"
                               FontAttributes="Bold"/>
                        <GraphicsView x:Name="WaveformView"
                                      HeightRequest="40" HorizontalOptions="Fill"/>
                    </VerticalStackLayout>
                </Border>

                <!-- ══ Row 6: Spacer ══ -->
                <BoxView Grid.Row="6" HeightRequest="4"/>

                <!-- ══ Row 7: Alert Banner (hidden by default) ══ -->
                <Border x:Name="AlertBanner" Grid.Row="7"
                        IsVisible="False"
                        BackgroundColor="{StaticResource DangerBackground}"
                        Padding="16,14" StrokeThickness="1"
                        Stroke="{StaticResource GlowRed}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border WidthRequest="44" HeightRequest="44"
                                BackgroundColor="#30F87171" StrokeThickness="0"
                                VerticalOptions="Start">
                            <Border.StrokeShape><RoundRectangle CornerRadius="22"/></Border.StrokeShape>
                            <Label Text="⚠" FontSize="22"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label x:Name="AlertTypeLabel"
                                   FontSize="15" FontAttributes="Bold" TextColor="#FCA5A5"/>
                            <Label x:Name="AlertMessageLabel"
                                   FontSize="13" TextColor="#FECACA"
                                   LineBreakMode="TailTruncation"/>
                            <Label x:Name="AlertConfidenceLabel"
                                   FontSize="12" TextColor="#FCA5A5" Opacity="0.8"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

            </Grid>
        </ScrollView>

        <!-- ════════════════════════════════════════════════════════
             Report Number Bottom Sheet Overlay
             ════════════════════════════════════════════════════════ -->
        <Grid x:Name="ReportSheetOverlay" IsVisible="False">

            <!-- Dimmed backdrop — tap here to dismiss (separate from panel so tap doesn't bleed through) -->
            <BoxView x:Name="ReportBackdrop"
                     Color="#80000000"
                     HorizontalOptions="Fill" VerticalOptions="Fill">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnReportBackdropTapped"/>
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Sheet panel slides up from bottom -->
            <Border x:Name="ReportSheetPanel"
                    BackgroundColor="#1A2535"
                    Stroke="#2A3F54" StrokeThickness="1"
                    VerticalOptions="End"
                    Padding="24,16,24,40">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="18">

                    <!-- Handle bar -->
                    <BoxView HeightRequest="4" WidthRequest="44"
                             CornerRadius="2" Color="#3A4F63"
                             HorizontalOptions="Center" Margin="0,4,0,0"/>

                    <!-- Title row -->
                    <Grid ColumnDefinitions="*,40">
                        <Label Grid.Column="0"
                               Text="Report number"
                               FontSize="20" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1B2530, Dark=White}"
                               VerticalOptions="Center"/>
                        <Border Grid.Column="1"
                                BackgroundColor="#0DFFFFFF"
                                Stroke="Transparent" StrokeThickness="0"
                                HeightRequest="36" WidthRequest="36"
                                HorizontalOptions="End">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseReportSheetTapped"/>
                            </Border.GestureRecognizers>
                            <Label Text="✕" FontSize="14" TextColor="#8B9CAF"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </Grid>

                    <!-- Phone number field -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="PHONE NUMBER"
                               FontSize="10" CharacterSpacing="1.5"
                               TextColor="#6B7C8D" FontAttributes="Bold"/>
                        <Border BackgroundColor="#0F1923"
                                Stroke="#2A3F54" StrokeThickness="1"
                                Padding="16,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Entry x:Name="ReportPhoneEntry"
                                   Placeholder="+1 234 567 8900"
                                   PlaceholderColor="#3A4F63"
                                   TextColor="{AppThemeBinding Light=#1B2530, Dark=White}"
                                   BackgroundColor="Transparent"
                                   HeightRequest="50"
                                   Keyboard="Telephone"
                                   TextChanged="OnReportPhoneChanged"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Label / Description field -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="LABEL"
                               FontSize="10" CharacterSpacing="1.5"
                               TextColor="#6B7C8D" FontAttributes="Bold"/>
                        <Border BackgroundColor="#0F1923"
                                Stroke="#2A3F54" StrokeThickness="1"
                                Padding="16,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Entry x:Name="ReportLabelEntry"
                                   Placeholder="Bank scam, Robocall..."
                                   PlaceholderColor="#3A4F63"
                                   TextColor="{AppThemeBinding Light=#1B2530, Dark=White}"
                                   BackgroundColor="Transparent"
                                   HeightRequest="50"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Threat level selector -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="THREAT LEVEL"
                               FontSize="10" CharacterSpacing="1.5"
                               TextColor="#6B7C8D" FontAttributes="Bold"/>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <!-- Low -->
                            <Border x:Name="ThreatLowBorder" Grid.Column="0"
                                    BackgroundColor="#1B2838"
                                    Stroke="#2A3F54" StrokeThickness="1"
                                    Padding="0,12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnThreatLevelTapped"
                                                          CommandParameter="Low"/>
                                </Border.GestureRecognizers>
                                <Label x:Name="ThreatLowLabel" Text="Low"
                                       HorizontalOptions="Center"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="#6B7C8D"/>
                            </Border>
                            <!-- Medium (default selected) -->
                            <Border x:Name="ThreatMediumBorder" Grid.Column="1"
                                    BackgroundColor="#F97316"
                                    Stroke="#F97316" StrokeThickness="1"
                                    Padding="0,12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnThreatLevelTapped"
                                                          CommandParameter="Medium"/>
                                </Border.GestureRecognizers>
                                <Label x:Name="ThreatMediumLabel" Text="Medium"
                                       HorizontalOptions="Center"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#1B2530, Dark=White}"/>
                            </Border>
                            <!-- High -->
                            <Border x:Name="ThreatHighBorder" Grid.Column="2"
                                    BackgroundColor="#1B2838"
                                    Stroke="#2A3F54" StrokeThickness="1"
                                    Padding="0,12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnThreatLevelTapped"
                                                          CommandParameter="High"/>
                                </Border.GestureRecognizers>
                                <Label x:Name="ThreatHighLabel" Text="High"
                                       HorizontalOptions="Center"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="#6B7C8D"/>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Submit button -->
                    <Button x:Name="SubmitReportButton"
                            Text="Report number"
                            FontSize="15" FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light=#1B2530, Dark=White}" CornerRadius="14"
                            HeightRequest="52"
                            IsEnabled="False" Opacity="0.4"
                            Clicked="OnSubmitReportClicked">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F97316" Offset="0"/>
                                <GradientStop Color="#EA580C" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
