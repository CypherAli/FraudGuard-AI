# ============================================================
# FraudGuard AI - API Gateway Environment Configuration
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# Database (PostgreSQL)
# Cloud deployment (Render/Railway): set DATABASE_URL only
# Local development: set individual DB_* variables
# ------------------------------------------------------------
DATABASE_URL=postgres://user:password@host:5432/fraudguard_db?sslmode=require

# Local development only (ignored if DATABASE_URL is set)
DB_HOST=localhost
DB_PORT=5433
DB_USER=fraudguard
DB_PASSWORD=your_db_password_here
DB_NAME=fraudguard_db
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# ------------------------------------------------------------
# Server
# Note: Render uses PORT env var automatically
# ------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
GO_ENV=production

# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------
CORS_ALLOWED_ORIGIN=*

# ------------------------------------------------------------
# WebSocket
# ------------------------------------------------------------
WS_READ_BUFFER_SIZE=1024
WS_WRITE_BUFFER_SIZE=1024
WS_PING_INTERVAL=60s
WS_PONG_TIMEOUT=10s

# ------------------------------------------------------------
# External AI APIs (get keys from dashboard)
# Deepgram: https://console.deepgram.com
# Gemini:   https://aistudio.google.com/app/apikey
# ------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
VECTOR_DB_URL=

# ------------------------------------------------------------
# AWS — Amazon Transcribe (Fallback STT khi Deepgram fail)
# Setup: https://console.aws.amazon.com/iam
# Region: ap-southeast-1 (Singapore, gần VN nhất)
# Required IAM permissions: transcribe:StartStreamTranscription
# ------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=ap-southeast-1

# ------------------------------------------------------------
# Redis (optional - for caching)
# ------------------------------------------------------------
REDIS_URL=

# ------------------------------------------------------------
# Fraud Detection Thresholds (0-100)
# ------------------------------------------------------------
FRAUD_THRESHOLD_LOW=20
FRAUD_THRESHOLD_MEDIUM=40
FRAUD_THRESHOLD_HIGH=60
FRAUD_THRESHOLD_CRITICAL=80
FRAUD_MAX_AUDIO_AGE_SECONDS=300

# ------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------
FEATURE_DEEPFAKE=true
FEATURE_METRICS=true
FEATURE_REDIS=false
FEATURE_DATA_MASK=true

# ------------------------------------------------------------
# Audio Processing - Voice Activity Detection (VAD)
# ------------------------------------------------------------
VAD_ENABLED=true
VAD_AGGRESSIVENESS=2
VAD_SAMPLE_RATE=16000
VAD_PRE_PADDING_MS=300
VAD_POST_PADDING_MS=300

# ------------------------------------------------------------
# Audio Processing - High-Pass Filter (HPF)
# Removes low-frequency noise from weak hardware AEC
# ------------------------------------------------------------
HPF_ENABLED=true
HPF_CUTOFF_FREQ=300.0

# ------------------------------------------------------------
# Fraud Analysis
# ------------------------------------------------------------
TRACK_SILENCE_EVENTS=true

# ------------------------------------------------------------
# Docker Compose (local dev only)
# ------------------------------------------------------------
DB_PASSWORD=your_strong_db_password_here
GRAFANA_PASSWORD=your_strong_grafana_password_here
