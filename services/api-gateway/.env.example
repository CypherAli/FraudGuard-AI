# ============================================================
# FraudGuard AI - API Gateway Environment Configuration
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5433
DB_USER=fraudguard
DB_PASSWORD=your_db_password_here
DB_NAME=fraudguard_db
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s

# ------------------------------------------------------------
# WebSocket
# ------------------------------------------------------------
WS_READ_BUFFER_SIZE=1024
WS_WRITE_BUFFER_SIZE=1024
WS_PING_INTERVAL=60s
WS_PONG_TIMEOUT=10s

# ------------------------------------------------------------
# External AI APIs (get keys from dashboard)
# Deepgram: https://console.deepgram.com
# Gemini:   https://aistudio.google.com/app/apikey
# ------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
VECTOR_DB_URL=your_vector_db_url_here

# ------------------------------------------------------------
# Audio Processing - Voice Activity Detection (VAD)
# ------------------------------------------------------------
VAD_ENABLED=true
VAD_AGGRESSIVENESS=2
VAD_SAMPLE_RATE=16000
VAD_PRE_PADDING_MS=300
VAD_POST_PADDING_MS=300

# ------------------------------------------------------------
# Audio Processing - High-Pass Filter (HPF)
# Removes low-frequency noise from weak hardware AEC
# ------------------------------------------------------------
HPF_ENABLED=true
HPF_CUTOFF_FREQ=300.0

# ------------------------------------------------------------
# Fraud Analysis
# ------------------------------------------------------------
TRACK_SILENCE_EVENTS=true
